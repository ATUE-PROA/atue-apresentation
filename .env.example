# Proxy server-side da demo (api/analyze.ts e o dev server do Vite).
# Nunca use prefixo VITE_ para segredos: esse prefixo vai para o bundle do navegador.

# URL base do atue-ai-service, sem barra final.
ATUE_AI_URL=
# Chave inbound do atue-ai-service (a mesma ATUE_API_KEY dele). Não é a chave da NVIDIA.
ATUE_API_KEY=
